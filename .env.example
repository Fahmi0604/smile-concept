# Smile Concept CMS (Laravel). No trailing slash.
# Endpoints used: /posts, /posts/{identifier}, /promos, /promos/{identifier}, /settings
# NOTE: the CMS throttles at 5 requests per minute per IP.
NEXT_PUBLIC_CMS_API_URL=https://cms.tumbuhsehat.id/api

# Public origin of this site — used for canonical URLs, OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://smileconcept.id
